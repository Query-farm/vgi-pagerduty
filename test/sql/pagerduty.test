# --------------------------------------------------------------------- changes

query TTTT
SELECT change_event_id, summary, services, links[1].text FROM pagerduty.main.change_events(since := TIMESTAMPTZ '2026-06-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00')
ORDER BY occurred_at;
----
PCE4	Deploy checkout v2.2.0	[Checkout API]	NULL
PCE3	Deploy search v1.9	[Search]	NULL
PCE1	Deploy checkout v2.3.1	[Checkout API]	CI run 981
PCE2	Enable flag new-pricing	[Payments]	NULL

query TT
SELECT change_event_id, custom_details->>'sha' FROM pagerduty.main.change_events()
WHERE occurred_at >= TIMESTAMPTZ '2026-11-10 00:00:00+00' AND occurred_at < TIMESTAMPTZ '2026-11-11 00:00:00+00';
----
PCE1	a1b2c3d

query TT
SELECT query::JSON->>'since', query::JSON->>'until' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/change_events') ORDER BY seq DESC LIMIT 1;
----
2026-11-10T00:00:00.000Z	2026-11-11T00:00:00.000Z

# Changes on the same service in the hour before each incident.
query IT
SELECT i.incident_number, c.summary FROM pagerduty.main.incidents(date_range := 'all') i
JOIN pagerduty.main.change_events(since := TIMESTAMPTZ '2026-09-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00') c
  ON list_contains(c.service_ids, i.service_id)
 AND CAST(c.occurred_at AS TIMESTAMP) BETWEEN CAST(i.created_at AS TIMESTAMP) - INTERVAL 1 HOUR AND CAST(i.created_at AS TIMESTAMP)
ORDER BY 1;
----
1042	Deploy checkout v2.3.1
1043	Enable flag new-pricing

# ---------------------------------------------------------------- audit records

# A 70-day window is read in 31-day chunks with cursor paging (page_size := 2).
statement ok
CREATE TEMP TABLE mark AS SELECT coalesce(max(seq), 0) AS m FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?prefix=/');

query TTTTT
SELECT record_id, action, root_resource_type, actor_name, changed_fields[1].before_value || ' -> ' || changed_fields[1].value
FROM pagerduty.main.audit_records(page_size := 2)
WHERE execution_time >= TIMESTAMPTZ '2026-09-15 00:00:00+00' AND execution_time < TIMESTAMPTZ '2026-11-24 00:00:00+00'
ORDER BY execution_time;
----
PAR4	update	escalation_policies	Ada Lovelace	1 -> 2
PAR1	update	services	Ada Lovelace	7200 -> 14400
PAR2	create	teams	terraform	NULL
PAR3	delete	schedules	Grace Hopper	NULL
PAR5	update	users	Katherine Johnson	America/New_York -> America/Chicago

query II
SELECT count(DISTINCT query::JSON->>'since'), count(*) FILTER (query::JSON->>'cursor' IS NOT NULL) > 0
FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/audit/records') WHERE seq > (SELECT m FROM mark);
----
3	true

statement ok
DROP TABLE mark;

query TT
SELECT record_id, method_type FROM pagerduty.main.audit_records(since := TIMESTAMPTZ '2026-11-01 00:00:00+00', until := TIMESTAMPTZ '2026-11-30 00:00:00+00')
WHERE action IN ('create', 'delete') AND root_resource_type IN ('teams', 'schedules') AND actor_type = 'api_key_reference';
----
PAR2	api_token

query TTT
SELECT query::JSON->'actions[]', query::JSON->'root_resource_types[]', query::JSON->>'actor_type' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/audit/records') ORDER BY seq DESC LIMIT 1;
----
["create","delete"]	["teams","schedules"]	api_key_reference

