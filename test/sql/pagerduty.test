SELECT maintenance_window_id, services FROM pagerduty.main.maintenance_windows WHERE status = 'ongoing';
----
PMW2	[Search]

query T
SELECT query::JSON->>'filter' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/maintenance_windows') ORDER BY seq DESC LIMIT 1;
