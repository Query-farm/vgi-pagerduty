# -------------------------------------------------------- services and the graph

query TTTT
SELECT relationship_id, dependent_service_type, dependent_service_id, supporting_service_id FROM pagerduty.main.service_dependencies ORDER BY 1;
----
PREL1	business_service	PBSSTORE	PSVCCHK
PREL2	business_service	PBSSTORE	PSVCSEARCH
PREL3	business_service	PBSBILL	PSVCPAY
PREL4	service	PSVCCHK	PSVCPAY

query TT
SELECT b.name, s.name FROM pagerduty.main.service_dependencies d
JOIN pagerduty.main.business_services b ON b.business_service_id = d.dependent_service_id
JOIN pagerduty.main.services s ON s.service_id = d.supporting_service_id ORDER BY 1, 2;
----
Billing	Payments
Online Store	Checkout API
Online Store	Search

query TT
SELECT maintenance_window_id, status FROM pagerduty.main.maintenance_windows ORDER BY 1;
----
PMW1	past
PMW2	ongoing
PMW3	future

