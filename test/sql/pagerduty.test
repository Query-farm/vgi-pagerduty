query IRRIT
SELECT incident_number, time_to_ack_seconds, time_to_resolve_seconds, sleep_hour_interruptions, major
FROM pagerduty.main.analytics_incidents(since := TIMESTAMPTZ '2024-01-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00', page_size := 2)
ORDER BY 1;
----
12	300.0	3600.0	0	false
800	NULL	NULL	0	false
900	1200.0	7200.0	0	false
1030	600.0	5400.0	0	true
1042	240.0	3000.0	0	true
1043	900.0	NULL	2	false
1044	NULL	NULL	0	false

# Analytics and with_timeline agree on time to acknowledge.
query I
SELECT count(*) FROM pagerduty.main.analytics_incidents(since := TIMESTAMPTZ '2024-01-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00') a
JOIN pagerduty.main.incidents(date_range := 'all', with_timeline := true) i USING (incident_id)
WHERE a.time_to_ack_seconds IS NOT DISTINCT FROM i.time_to_ack_seconds;
----
7

query IT
SELECT incident_number, priority FROM pagerduty.main.analytics_incidents(since := TIMESTAMPTZ '2026-01-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00')
WHERE urgency = 'high' AND service_id IN ('PSVCCHK', 'PSVCPAY') AND major ORDER BY 1;
----
1030	P1
1042	P1

query TTT
SELECT body::JSON->'filters'->>'urgency', body::JSON->'filters'->'service_ids', body::JSON->'filters'->>'major'
FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/analytics/raw/incidents') ORDER BY seq DESC LIMIT 1;
----
high	["PSVCCHK","PSVCPAY"]	true

query TIRR
SELECT range_start, total_incident_count, mean_time_to_ack_seconds, mean_time_to_resolve_seconds
FROM pagerduty.main.analytics_incident_metrics(since := TIMESTAMPTZ '2026-09-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00', aggregate_unit := 'month')
ORDER BY 1;
----
2026-09-01 00:00:00+00	1	600.0	5400.0
2026-11-01 00:00:00+00	3	570.0	3000.0

query IR
SELECT total_incident_count, mean_time_to_ack_seconds FROM pagerduty.main.analytics_incident_metrics(since := TIMESTAMPTZ '2026-01-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00', urgency := 'low');
----
3	1200.0

