# name: test/sql/pagerduty.test
# description: SQL tests for the pagerduty worker against the strict offline PagerDuty replay server (test/mock_api/server.py)
# group: [pagerduty]

require vgi

require-env PAGERDUTY_WORKER

require-env PAGERDUTY_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'pagerduty' (TYPE vgi, LOCATION '{PAGERDUTY_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM pagerduty.main.services;
----
<REGEX>:.*no pagerduty secret.*

statement ok
CREATE SECRET pd_bad (TYPE pagerduty, API_TOKEN 'wrong-token', BASE_URL '{PAGERDUTY_FIXTURE_URL}');

statement error
SELECT count(*) FROM pagerduty.main.priorities;
----
<REGEX>:.*HTTP 401.*code 2006.*

statement ok
DROP SECRET pd_bad;

statement ok
CREATE SECRET pd_insecure (TYPE pagerduty, API_TOKEN 'x', BASE_URL 'http://api.pagerduty.com');

statement error
SELECT count(*) FROM pagerduty.main.priorities;
----
<REGEX>:.*https.*

statement ok
DROP SECRET pd_insecure;

statement ok
CREATE SECRET pd_region (TYPE pagerduty, API_TOKEN 'x', REGION 'mars');

statement error
SELECT count(*) FROM pagerduty.main.priorities;
----
<REGEX>:.*region must be 'us' or 'eu'.*

statement ok
DROP SECRET pd_region;

statement ok
CREATE SECRET pd_empty (TYPE pagerduty, REGION 'eu');

statement error
SELECT count(*) FROM pagerduty.main.priorities;
----
<REGEX>:.*API_TOKEN.*OAUTH_TOKEN.*

statement ok
DROP SECRET pd_empty;

# OAuth bearer tokens work too.
statement ok
CREATE SECRET pd_oauth (TYPE pagerduty, OAUTH_TOKEN 'test-oauth', BASE_URL '{PAGERDUTY_FIXTURE_URL}');

query I
SELECT count(*) FROM pagerduty.main.tags;
----
3

query T
SELECT auth FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/tags') ORDER BY seq DESC LIMIT 1;
----
bearer

statement ok
DROP SECRET pd_oauth;

statement ok
CREATE SECRET pd (TYPE pagerduty, API_TOKEN 'test-token', BASE_URL '{PAGERDUTY_FIXTURE_URL}');

# -------------------------------------------------------- rate limits and retries

# The first /services request is a 429 (ratelimit-reset: 1); the first /priorities a 503.
query TTT
SELECT name, status, urgency_rule FROM pagerduty.main.services ORDER BY name;
----
Checkout API	active	constant:high
Payments	warning	use_support_hours
Search	disabled	constant:low

query I
SELECT count(*) >= 2 FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/services');
----
true

query ITT
SELECT rank, name, description FROM pagerduty.main.priorities ORDER BY rank;
----
1	P1	Critical: customer-facing outage
2	P2	High: degraded service
3	P3	Moderate: internal impact

# ------------------------------------------------------------------- incidents

query IITTTTT
SELECT incident_number, time_to_resolve_seconds, status, urgency, priority, service, assignees
FROM pagerduty.main.incidents(date_range := 'all') ORDER BY incident_number;
----
12	3600.0	resolved	high	NULL	Checkout API	[]
800	NULL	triggered	low	NULL	Search	[Alan Turing]
900	7200.0	resolved	low	P3	Payments	[]
1030	5400.0	resolved	high	P1	Checkout API	[]
1042	3000.0	resolved	high	P1	Checkout API	[]
1043	NULL	acknowledged	high	P2	Payments	[Grace Hopper]
1044	NULL	triggered	low	NULL	Search	[Alan Turing]

# Without the timeline only an open incident's current acknowledgement is known.
query ITRT
SELECT incident_number, acknowledged_at, time_to_ack_seconds, timeline_source
FROM pagerduty.main.incidents(date_range := 'all') WHERE incident_number IN (1042, 1043) ORDER BY 1;
----
1042	NULL	NULL	incident
1043	2026-11-12 22:30:00+00	900.0	incident

# with_timeline reads each incident's log entries: exact MTTA / MTTR, who acked and resolved.
query IRRTTIT
SELECT incident_number, time_to_ack_seconds, time_to_resolve_seconds, acknowledged_by, resolved_by, escalation_count, timeline_source
FROM pagerduty.main.incidents(date_range := 'all', with_timeline := true) ORDER BY incident_number;
----
12	300.0	3600.0	Ada Lovelace	Ada Lovelace	0	log_entries
800	NULL	NULL	NULL	NULL	0	log_entries
900	1200.0	7200.0	Katherine Johnson	Katherine Johnson	0	log_entries
1030	600.0	5400.0	Alan Turing	Alan Turing	1	log_entries
1042	240.0	3000.0	Ada Lovelace	Alan Turing	0	log_entries
1043	900.0	NULL	Grace Hopper	NULL	1	log_entries
1044	NULL	NULL	NULL	NULL	0	log_entries

query I
SELECT count(*) FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?prefix=/incidents/') WHERE path LIKE '%/log_entries' AND query::JSON->>'is_overview' = 'true';
----
7

# Pushdown: status / urgency / service_id become PagerDuty's array parameters.
query I
SELECT incident_number FROM pagerduty.main.incidents(date_range := 'all')
WHERE status = 'resolved' AND urgency = 'high' AND service_id IN ('PSVCCHK', 'PSVCPAY') ORDER BY 1;
----
12
1030
1042

query TTTT
SELECT query::JSON->>'statuses[]', query::JSON->>'urgencies[]', query::JSON->'service_ids[]', query::JSON->>'date_range'
FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') ORDER BY seq DESC LIMIT 1;
----
resolved	high	["PSVCCHK","PSVCPAY"]	all

# An open-only status filter with no time bound reads every open incident (date_range=all).
query IT
SELECT incident_number, status FROM pagerduty.main.incidents() WHERE status IN ('triggered', 'acknowledged') ORDER BY 1;
----
800	triggered
1043	acknowledged
1044	triggered

query TT
SELECT query::JSON->'statuses[]', query::JSON->>'date_range' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') ORDER BY seq DESC LIMIT 1;
----
["triggered","acknowledged"]	all

# The default window is the last 30 days.
statement ok
SELECT count(*) FROM pagerduty.main.incidents();

query II
SELECT date_diff('day', CAST(query::JSON->>'since' AS TIMESTAMP), CAST(query::JSON->>'until' AS TIMESTAMP)), query::JSON->>'total' = 'true'
FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') ORDER BY seq DESC LIMIT 1;
----
30	true

# A created_at range longer than PagerDuty's 6-month limit is read in 180-day chunks.
statement ok
CREATE TEMP TABLE mark AS SELECT max(seq) AS m FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?prefix=/');

query I
SELECT count(*) FROM pagerduty.main.incidents()
WHERE created_at >= TIMESTAMPTZ '2024-01-01 00:00:00+00' AND created_at < TIMESTAMPTZ '2026-12-01 00:00:00+00';
----
7

query III
SELECT count(*), max(date_diff('day', CAST(query::JSON->>'since' AS TIMESTAMP), CAST(query::JSON->>'until' AS TIMESTAMP))) <= 180,
       min(query::JSON->>'since') = '2024-01-01T00:00:00.000Z'
FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') WHERE seq > (SELECT m FROM mark);
----
6	true	true

statement ok
DROP TABLE mark;

# since := / until := arguments set the window too, and several pages are read (page_size := 2).
query II
SELECT count(*), count(DISTINCT incident_id)
FROM pagerduty.main.incidents(since := TIMESTAMPTZ '2026-09-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00', page_size := 2);
----
4	4

query I
SELECT count(*) FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') WHERE query::JSON->>'limit' = '2';
----
2

# Newest first + LIMIT stops paging early.
query I
SELECT incident_number FROM pagerduty.main.incidents(date_range := 'all', sort_by := 'created_at:desc', page_size := 2) LIMIT 1;
----
1044

# team_ids / user_ids arguments are array parameters.
query I
SELECT incident_number FROM pagerduty.main.incidents(date_range := 'all', team_ids := ['PTEAMPAY'], user_ids := ['PUSRGRACE']) ORDER BY 1;
----
1043

query TT
SELECT query::JSON->>'team_ids[]', query::JSON->>'user_ids[]' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') ORDER BY seq DESC LIMIT 1;
----
PTEAMPAY	PUSRGRACE

# incident_id = / IN fetches those incidents directly; an unknown id is zero rows.
query IT
SELECT incident_number, title FROM pagerduty.main.incidents() WHERE incident_id IN ('Q2CHECKOUT500', 'Q2LEGACY', 'QNOPE') ORDER BY 1;
----
12	Legacy checkout outage
1042	Checkout API 500s

query I
SELECT count(*) FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents/QNOPE');
----
1

query I
SELECT incident_number FROM pagerduty.main.incidents(date_range := 'all') WHERE incident_key = 'pay-latency';
----
1043

query T
SELECT query::JSON->>'incident_key' FROM read_json('{PAGERDUTY_FIXTURE_URL}/__requests?path=/incidents') ORDER BY seq DESC LIMIT 1;
----
pay-latency

# Bind-time argument constraints.
statement error
SELECT * FROM pagerduty.main.incidents(sort_by := 'title');
----
<REGEX>:.*sort_by.*

statement error
SELECT * FROM pagerduty.main.incidents(page_size := 500);
----
<REGEX>:.*page_size.*

# ------------------------------------------------------------ incident timeline

query TTTTTT
SELECT type, agent_name, strftime(CAST(created_at AS TIMESTAMP), '%H:%M:%S'), assignees, user_name || '/' || notification_type, note
FROM pagerduty.main.incident_log_entries(incident_id := 'Q2CHECKOUT500') ORDER BY created_at;
----
trigger	Checkout API	09:00:00	NULL	NULL	NULL
notify	Checkout API	09:00:30	NULL	Ada Lovelace/phone	NULL
acknowledge	Ada Lovelace	09:04:00	NULL	NULL	NULL
annotate	Ada Lovelace	09:10:00	NULL	NULL	Rolling back v2.3.1
assign	Ada Lovelace	09:12:00	[Alan Turing]	NULL	NULL
resolve	Alan Turing	09:50:00	NULL	NULL	NULL

# Account-wide, windowed; WHERE incident_id IN reads the per-incident endpoint instead.
query II
SELECT count(*), count(DISTINCT incident_id)
FROM pagerduty.main.incident_log_entries(since := TIMESTAMPTZ '2026-09-01 00:00:00+00', until := TIMESTAMPTZ '2026-12-01 00:00:00+00', is_overview := true);
----
13	4

query TI
SELECT incident_id, count(*) FROM pagerduty.main.incident_log_entries() WHERE incident_id IN ('Q2PAYOLD', 'Q2LEGACY') GROUP BY 1 ORDER BY 1;
----
Q2LEGACY	3
Q2PAYOLD	4

# Time to acknowledge computed from the timeline in SQL.
query R
SELECT date_diff('second', CAST(min(created_at) FILTER (type = 'trigger') AS TIMESTAMP), CAST(min(created_at) FILTER (type = 'acknowledge') AS TIMESTAMP))
FROM pagerduty.main.incident_log_entries(incident_id := 'Q2CHECKOUTDNS');
----
600

